# Copy to .env (never commit .env). No secrets are required: the Elexon datasets used need no API key.

# --- backend ---
# Comma-separated browser origins allowed by CORS (set to your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
# Directory holding the cached extract (default: <repo>/data)
# DATA_DIR=./data
# Evaluation window (UK delivery dates) used by the refresh command and request validation
# WINDOW_START=2026-01-01
# WINDOW_END=2026-01-31
# Default decision rule offered by the API: N days before delivery, at HH:MM UK local time
# DEFAULT_CUTOFF_DAYS_BEFORE=1
# DEFAULT_CUTOFF_LOCAL_TIME=09:00
# Elexon client behaviour (refresh command only)
# ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=4

# --- frontend (build-time) ---
# Leave empty for local dev / Docker (same-origin /api proxy). On Vercel set to the hosted backend URL.
VITE_API_BASE_URL=
